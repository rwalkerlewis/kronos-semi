{
  "schema_version": "2.10.0",
  "name": "mosfet_3d_sat",
  "description": "M19 capstone (saturation regime): same 3D n-channel MOSFET device as mosfet_3d (fixtures/mosfet3d.msh, p-type Si body N_A = 1e16 cm^-3, 5 nm SiO2, Gaussian n+ source/drain, Lombardi+Caughey-Thomas mobility, Fermi-Dirac statistics) but biased into saturation at V_DS = 1.0 V. V_GS sweeps 0 to 2.0 V at 0.4 V step (5 points to keep runtime tolerable). I_DSAT is verified within +-30% of the velocity-saturation analytical reference semi.diode_analytical.mosfet_3d_saturation_iv over [V_T + 0.4, V_T + 1.6] V.",
  "dimension": 3,
  "mesh": {
    "source": "file",
    "path": "fixtures/mosfet3d.msh",
    "format": "gmsh"
  },
  "regions": {
