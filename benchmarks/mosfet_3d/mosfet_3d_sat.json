      "material": "Si",
      "tag": 1,
      "role": "semiconductor"
    },
    "oxide": {
      "material": "SiO2",
      "tag": 2,
      "role": "insulator"
    }
  },
  "doping": [
    {
      "region": "silicon",
      "profile": {
        "type": "uniform",
        "N_D": 0.0,
        "N_A": 1e+16
      }
    },
    {
      "region": "silicon",
      "profile": {
        "type": "gaussian",
        "center": [
          0.0,
          5e-07,
          2e-07
        ],
        "sigma": [
          9e-08,
          1e-05,
          1.5e-07
        ],
        "peak": 5e+19,
        "dopant": "donor"
      }
    },
    {
      "region": "silicon",
      "profile": {
        "type": "gaussian",
        "center": [
          1e-06,
          5e-07,
          2e-07
        ],
        "sigma": [
          9e-08,
          1e-05,
          1.5e-07
        ],
        "peak": 5e+19,
        "dopant": "donor"
      }
    }
  ],
  "contacts": [
    {
      "name": "body",
      "facet": 13,
      "type": "ohmic",
      "voltage": 0.0
    },
    {
      "name": "source",
